# Copy this file to ".env" and fill in your own values for LOCAL testing.
# On GitHub, these go into repo Settings > Secrets and variables > Actions
# instead (see README). None of these require a credit card.

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlmNoPQRsTUvwxyz
# Your personal chat id (the bot sends the digest here). README shows how to get it.
TELEGRAM_CHAT_ID=123456789

# --- Google Programmable Search (free: 100 queries/day, no card needed) ---
GOOGLE_SEARCH_API_KEY=your_google_api_key
GOOGLE_SEARCH_ENGINE_ID=your_cx_id

# --- Google Gemini (free tier, no card needed) ---
GEMINI_API_KEY=your_gemini_api_key
